<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pwp.gui</groupId>
    <artifactId>PerWorldPluginsGUI</artifactId>
    <version>1.2</version>
    <packaging>jar</packaging>

    <!--
        BUILD PROFILES
        ══════════════
        Default  : targets Paper/Purpur 1.21.x  →  mvn package
        v26       : targets Paper/Purpur 26.x   →  mvn package -P v26

        Each profile selects the appropriate Paper API coordinate and
        filters src/main/resources so plugin.yml gets the right api-version.
    -->

    <profiles>

        <!-- ── Profile: 1.21.x (default) ───────────────────────────────── -->
        <profile>
            <id>v121</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <!-- Java version shipped with 1.21.x servers -->
                <maven.compiler.release>21</maven.compiler.release>
                <!-- Values injected into plugin.yml via Maven resource filtering -->
                <plugin.apiVersion>1.21</plugin.apiVersion>
                <paper.version>1.21.4-R0.1-SNAPSHOT</paper.version>
            </properties>
            <repositories>
                <repository>
                    <id>papermc</id>
                    <name>PaperMC Maven Repository</name>
                    <url>https://repo.papermc.io/repository/maven-public/</url>
                </repository>
                <repository>
                    <id>purpurmc</id>
                    <name>PurpurMC Maven Repository</name>
                    <url>https://repo.purpurmc.org/snapshots</url>
                </repository>
            </repositories>
            <dependencies>
                <dependency>
                    <groupId>io.papermc.paper</groupId>
                    <artifactId>paper-api</artifactId>
                    <version>${paper.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>

        <!-- ── Profile: 26.x ───────────────────────────────────────────── -->
        <profile>
            <id>v26</id>
            <properties>
                <!-- 26.x servers require Java 25 -->
                <maven.compiler.release>25</maven.compiler.release>
                <plugin.apiVersion>26.3</plugin.apiVersion>
                <!--
                    Replace the build number below with the latest stable build
                    from https://repo.papermc.io/repository/maven-public/
                    (io/papermc/paper/paper-api/)
                -->
                <paper.version>26.3.build.90-stable</paper.version>
            </properties>
            <repositories>
                <repository>
                    <id>papermc</id>
                    <name>PaperMC Maven Repository</name>
                    <url>https://repo.papermc.io/repository/maven-public/</url>
                </repository>
                <repository>
                    <id>purpurmc</id>
                    <name>PurpurMC Maven Repository</name>
                    <url>https://repo.purpurmc.org/snapshots</url>
                </repository>
            </repositories>
            <dependencies>
                <dependency>
                    <groupId>io.papermc.paper</groupId>
                    <artifactId>paper-api</artifactId>
                    <version>${paper.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>

    </profiles>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <!-- Enable @{plugin.apiVersion} substitution inside plugin.yml -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Built-By>PerWorldPluginsGUI</Built-By>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
